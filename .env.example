# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.zebcge8.mongodb.net/?appName=Cluster0"
MONGODB_DB_NAME="outreach_flow"

# Microsoft Graph App-Only Service Account (Client Credentials)
# Server-only environment variables — NEVER expose these to the browser.
MICROSOFT_GRAPH_TENANT_ID="b14c591a-a24b-4326-bef7-c761fac2ad3c"
MICROSOFT_GRAPH_CLIENT_ID="2fb01789-59e5-4414-9008-1e2ec409740f"
MICROSOFT_GRAPH_CLIENT_SECRET="YOUR_CLIENT_SECRET"
MICROSOFT_GRAPH_SERVICE_ACCOUNT="outreach@yourdomain.com"
MICROSOFT_GRAPH_DISPLAY_NAME="Outreach Flow"
