# ==============================================================================
# GINI / OUTREACH FLOW - ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# On production hosting platforms (Vercel, Cloud Run, Render, Railway, AWS),
# configure these environment variables in your platform's dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MONGODB_URI: Full connection string from MongoDB Atlas.
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/?appName=Cluster0"

# MONGODB_DB_NAME: Target database name inside MongoDB Atlas (default: outreach_flow)
MONGODB_DB_NAME="outreach_flow"


# ------------------------------------------------------------------------------
# 2. APPLICATION & HOSTING ENVIRONMENT
# ------------------------------------------------------------------------------
# NODE_ENV: Set to 'production' on hosting, 'development' when working locally
NODE_ENV="development"

# PORT: Server listener port (defaults to 3000 locally; Cloud platforms set this automatically)
PORT=3000

# APP_URL: The canonical public base URL of your deployed application (NO trailing slash).
# IMPORTANT: Tracking pixels, click redirects, OAuth callbacks, and email webhooks use this.
# Examples:
#   Local:      http://localhost:3000
#   Production: https://your-domain.com  or  https://your-app.vercel.app
APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 3. AI WRITING ASSISTANT (Google Gemini)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey).
# If left empty, the application uses an offline simulated copywriter fallback.
GEMINI_API_KEY=""

# GEMINI_MODEL: The Gemini model used for email drafting & rewriting (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"


# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Stateless JWT Sessions)
# ------------------------------------------------------------------------------
# AUTH_PROVIDER: Authentication mode ('local' is standard)
AUTH_PROVIDER="local"

# AUTH_SECRET: A strong 32+ character random string used to sign session cookies.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your-secure-random-32-char-auth-secret-here"

# Initial Administrator Credentials (created automatically on first boot if not in DB):
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="YourSecureAdminPassword123!"
ADMIN_NAME="System Administrator"

# Optional Initial Team Member (created automatically on first boot):
USER_EMAIL=""
USER_PASSWORD=""
USER_NAME=""


# ------------------------------------------------------------------------------
# 5. MICROSOFT 365 / MICROSOFT GRAPH (Outbound Email & Reply Webhooks)
# ------------------------------------------------------------------------------
# Required ONLY if you send outbound emails via Microsoft Graph Client Credentials (App-Only):
# Register an app in Azure Portal (portal.azure.com) -> App Registrations with Mail.Send permission.

# MICROSOFT_GRAPH_TENANT_ID: Azure Active Directory Directory (Tenant) ID (UUID)
MICROSOFT_GRAPH_TENANT_ID="your-tenant-id-here"

# MICROSOFT_GRAPH_CLIENT_ID: Azure App Registration Application (Client) ID (UUID)
MICROSOFT_GRAPH_CLIENT_ID="your-client-id-here"

# MICROSOFT_GRAPH_CLIENT_SECRET: Azure App Registration Client Secret Value
MICROSOFT_GRAPH_CLIENT_SECRET="your-client-secret-here"

# MICROSOFT_GRAPH_SERVICE_ACCOUNT: The Microsoft 365 mailbox to send emails from
MICROSOFT_GRAPH_SERVICE_ACCOUNT="your-service-account@yourdomain.com"

# MICROSOFT_GRAPH_DISPLAY_NAME: The friendly sender name displayed in recipient inboxes
MICROSOFT_GRAPH_DISPLAY_NAME="Outreach Flow"

# MICROSOFT_GRAPH_CLIENT_STATE: Shared secret token validated against inbound webhook payloads
MICROSOFT_GRAPH_CLIENT_STATE="your-random-webhook-secret-state-token"


# ------------------------------------------------------------------------------
# 6. PRODUCTION SAFETY CONTROLS
# ------------------------------------------------------------------------------
# ALLOW_PROD_TEST_SEND: Set to 'true' only if you want to allow test email sending in production.
ALLOW_PROD_TEST_SEND="false"
